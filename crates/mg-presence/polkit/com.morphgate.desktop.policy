<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- Installed to /usr/share/polkit-1/actions/ by packages, or by MorphGate itself (pkexec). -->
<policyconfig>
  <vendor>MorphGate</vendor>
  <vendor_url>https://morphgate.com</vendor_url>
  <action id="com.morphgate.desktop.unlock">
    <description>Unlock the MorphGate vault</description>
    <message>Authenticate to unlock MorphGate</message>
    <icon_name>morphgate</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <!-- Ask every time: no "_keep", so one success doesn't cover the next unlock. -->
      <allow_active>auth_self</allow_active>
    </defaults>
  </action>
</policyconfig>
