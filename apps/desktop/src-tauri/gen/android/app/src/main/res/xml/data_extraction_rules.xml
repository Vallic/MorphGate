<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing of the app's leaves the phone through Android's backups: the vault (encrypted), its
     settings and the unlock key sealed by this phone's Keystore stay here. No cloud backup, no
     device-to-device transfer (Android 12 and newer; allowBackup="false" covers older ones). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
